# Environment variables for Production (e.g. Render Deployment)
# Vite requires VITE_ prefix to expose variables to client-side code

VITE_API_ROOT=/api
VITE_MEMBER_SERVICE_URL=https://your-member-service.onrender.com
VITE_ORGANIZATION_SERVICE_URL=https://your-organization-service.onrender.com
VITE_BOARD_TASK_SERVICE_URL=https://your-board-task-service.onrender.com
